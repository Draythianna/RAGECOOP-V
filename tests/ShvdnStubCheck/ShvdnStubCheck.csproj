<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time check that the server can use GTA.Math types from
    libs/ScriptHookVDotNet3.dll on .NET 6. It references things the same way
    RageCoop.Server does and reads a Race-style map with XmlSerializer.

      dotnet run -c Release (project: tests/ShvdnStubCheck, argument: the server output folder)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RageCoop.ShvdnStub\RageCoop.ShvdnStub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>..\..\libs\ScriptHookVDotNet3.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
